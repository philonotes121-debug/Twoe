{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api?__path=/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=/api/$1"
    },
    {
      "source": "/webapp/(.*)",
      "destination": "/api?__path=/webapp/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2 * * *"
    }
  ]
}
