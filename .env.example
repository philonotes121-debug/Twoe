# Required
BOT_TOKEN=
ADMIN_ID=
# SQLAlchemy database URL. MUST be PostgreSQL (postgres:// or postgresql://)
# for persistent production data; MongoDB mongodb:// or mongodb+srv:// is NOT supported.
DATABASE_URL=
# Optional aliases accepted if a Vercel/Neon integration exposes Postgres under another name.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
WEBAPP_BASE_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
CRON_SECRET=
DATA_ENCRYPTION_KEY=
REFERRAL_SIGNING_SECRET=
GEMINI_API_KEY=

# Telegram access
BACKUP_CHANNEL=
BACKUP_CHAT_ID=
REQUIRE_BACKUP_FOR_FEATURES=0
HELP_BOT_USERNAME=

# AI / presence
GEMINI_MODELS=
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
ADMIN_OFFLINE_IDLE_MIN=20

# Security / network (optional outbound proxy/VPN gateway)
OUTBOUND_PROXY=

# Paid plans
COMMUNITY_PRICE_INR=800
CA_PRICE_INR=200
COMMUNITY_GROUP_LINK=
CA_DISPLAY_RATING=4.5
CA_REVIEW_COUNT=50

# Notion CA Tracker Pro
NOTION_API_TOKEN=
NOTION_CA_SOURCE_ID=
NOTION_EDITORIAL_SOURCE_ID=
NOTION_PLACE_NEWS_SOURCE_ID=
NOTION_INTERNATIONAL_ORGS_SOURCE_ID=
NOTION_ACCESS_SOURCE_ID=
NOTION_VERSION=2022-06-28

# Exam countdown / timezone
BOT_TIMEZONE=Asia/Kolkata
EXAM_NAME=UPSC Prelims 2027
EXAM_DATE=2027-05-23
COUNTDOWN_TIME=07:30

# Referral anti-abuse
REFERRAL_TOKEN_TTL_DAYS=365
REFERRAL_DAILY_REWARD_CAP=20
COINS_PER_REFERRAL=30
COINS_TO_REDEEM=300

# Optional payment provider
PAYMENT_PROVIDER_TOKEN=
STARS_PER_INR=0
# Optional production hardening
PERSONAL_DATA_HMAC_KEY=
MAX_WEB_BODY_BYTES=256000
CRON_STALE_MINUTES=10
